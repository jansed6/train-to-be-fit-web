# Copy this file to `.env.local` and fill in your Supabase project's values.
# Find them in the Supabase dashboard under Project Settings -> API.
# The publishable/anon key is a client-side key (safe to expose); access is
# enforced by Row-Level Security in the database.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key
